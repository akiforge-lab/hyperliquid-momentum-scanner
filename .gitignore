# ---------------------------------------------------------------------------
# Hyperliquid Momentum Scanner — .gitignore
#
# COMMITTED:   output/   (daily scan results — the point of this repo)
# NOT COMMITTED: data/   (ephemeral fetch cache — rebuilt on every run)
# ---------------------------------------------------------------------------

# Candle cache — rebuilt from the Hyperliquid API on every GHA run.
# Never commit: large, binary-ish JSON, changes every day, adds no value in git history.
data/candles/
data/candles_1h/

# Universe API response — informational, not source truth.
# Commit if you want a history of HL listing changes; omit if you prefer clean history.
data/universe.json

# Tracked-wallet overlay state — persists only on the DO host where the
# tracker runs.  Never committed: per-host state, would create merge conflicts.
data/wallet_state/

# Runtime logs (wallet tracker + momentum notifier).  Per-host, ephemeral.
data/logs/

# Momentum notifier persisted state / cache (signal + history snapshots).
# Per-host like wallet_state; never committed.
data/notifier_state/

# Intraday momentum stress overlay state (per-coin alert cooldowns).
# Per-host; never committed.
data/momentum_stress/

# Local cron wrappers — contain host-specific paths and source .env.
# Never committed (see scripts/README.md for how to recreate them).
scripts/run_track_wallets.sh
scripts/run_hl_notify.sh
scripts/run_momentum_stress.sh

# Keep the data/ directory itself trackable (for the .gitkeep below)
!data/.gitkeep

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
.env

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.iml
