# -----------------------------------------------------------------------------
# Tracked-wallet overlay — runtime credentials (DO host only)
#
# Copy to `.env` on the host (NEVER commit `.env`) and fill in real values.
# Cron does not auto-source this file — use the run_track_wallets.sh wrapper
# documented in scripts/README.md to load it before invoking Python.
# -----------------------------------------------------------------------------

# Telegram bot token from @BotFather (e.g. 123456:ABC-DEF...)
TELEGRAM_BOT_TOKEN=

# Target chat / channel id (numeric; negative for groups)
TELEGRAM_CHAT_ID=
